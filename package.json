{
  "name": "passwords-sqnfa-web",
  "version": "1.0.3",
  "author": "Martin Storgaard Dieu <info@sqnfa.com>",
  "description": "A pluggable client-side password validation pipeline with synchronous and asynchronous extension support.",
  "main": "./build/index.cjs",
  "types": "./build/src/index.d.ts",
  "files": [
    "build",
    "src",
    "docs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqnfa/passwords-sqnfa-web.git"
  },
  "bugs": {
    "url": "https://github.com/sqnfa/passwords-sqnfa-web/issues"
  },
  "keywords": [
    "password",
    "haveibeenpwned",
    "hibp",
    "authentication",
    "digital authentication",
    "electronic authentication",
    "credentials",
    "digital credentials",
    "electronic credentials"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "npm test -- --coverage",
    "lint": "oxlint src test scripts examples/vanilla.js examples/angular/src vitest.config.mjs && prettier --check .",
    "fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:release && npm run build && node scripts/package-smoke.mjs",
    "example:vanilla": "npm run build && node scripts/serve.mjs",
    "example:angular": "npm run build && npm --prefix examples/angular start",
    "build:angular": "npm run build && npm --prefix examples/angular run build",
    "prepare": "npm run build",
    "test:examples": "node scripts/examples-smoke.mjs",
    "test:release": "node --test test/release/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3"
  },
  "module": "./build/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./browser": "./build/passwords-sqnfa-web.min.js",
    "./package.json": "./package.json"
  }
}
